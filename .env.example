# 默认 mock 模式不会调用外部 API，也不会产生 API 费用。
AI_PROVIDER=mock
ALLOW_EXTERNAL_API_COST=0

# 本地真实转写模式：不调用外部 API，使用 faster-whisper 在本机完成转写。
# 需要项目目录已安装 .pydeps/faster_whisper，并且 scripts/transcribe_local.py 可用。
# AI_PROVIDER=local
# LOCAL_WHISPER_MODEL=medium
# LOCAL_WHISPER_LANGUAGE=zh
# DEFAULT_FEEDBACK_GENERATOR=local_llm
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=qwen3.5:4b
# LOCAL_LLM_API_KEY=
# 可选：如果你要启用项目内 Python 兼容服务，再补下面这些配置。
# HF_LOCAL_LLM_MODEL=Qwen/Qwen3.5-4B
# LOCAL_LLM_SERVER_HOST=127.0.0.1
# LOCAL_LLM_SERVER_PORT=8000
# LOCAL_LLM_DEVICE=cpu

# 需要真实调用当前账号 API 时，再显式打开以下配置。
# 注意：openai 模式会向 OpenAI 兼容接口发送音频和文本请求，是否产生费用取决于该账号/API 服务商计费规则。
# AI_PROVIDER=openai
# ALLOW_EXTERNAL_API_COST=1
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_CHAT_MODEL=gpt-4o-mini

# 反馈生成方式现在只走 LLM：
# - local_llm: 调本机 OpenAI 兼容接口，例如 Ollama / llama.cpp server
# - openai_llm: 调外部 OpenAI 兼容接口

# 后端和处理参数。0.0.0.0 代表同一局域网内其他设备也能访问。
HOST=0.0.0.0
PORT=5173
CHUNK_SECONDS=300
MAX_LIVE_AUDIO_MB=80

# 可选：设置后页面和 API 会要求输入这个访问口令。
# APP_ACCESS_TOKEN=change-me
